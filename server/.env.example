PORT=3001
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# MongoDB must be a replica set for atomic storage reservations.
MONGODB_URI=mongodb://localhost:27017/dropsync?replicaSet=rs0&directConnection=true
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Required for recoverable file uploads (private Amazon S3 Standard bucket).
# Use the bucket's exact AWS Region. Never use root-account access keys.
AWS_REGION=YOUR_BUCKET_REGION
AWS_S3_BUCKET=your-globally-unique-dropsync-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary AWS credentials; leave unset for IAM user access keys.
# AWS_SESSION_TOKEN=
# Shared with the GitHub Actions cleanup workflow; use a long random value.
CLEANUP_SECRET=
